module main

abstract class IFace<T> {
	pub abstract func getMyValue() -> IFace<T>
}

class A<T> {
	pub func init()!

	pub func doStuff() -> A<T> => this

	impl IFace<T> {
		func getMyValue() -> IFace<T> {

			return this
		}
	}
}

pub func main() -> Result<Int> {

	let a = new A<Int>()
	let b: A<Int> = a.doStuff()
}

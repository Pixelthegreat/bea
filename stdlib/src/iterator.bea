module iterator

/*
 * @brief Iterable object
 * @gparam T The type of value returned by the iterator
 */
pub abstract class Iterable<T> {

	/*
	 * @brief Create an iterator for this object
	 * @returns Iterator<T>
	 */
	pub abstract func iterator() -> Iterator<T>
}

/*
 * @brief Iterator
 * @gparam T The type of value returned by the iterator
 */
pub abstract class Iterator<T> {

	/*
	 * @brief Check if iterator has reached end
	 * @returns Boolean
	 */
	pub abstract func isAtEnd() -> Boolean

	/*
	 * @brief Get next item from iterator
	 * @returns T
	 */
	pub abstract func next() -> T
}

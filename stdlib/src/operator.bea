module operator

/*
 * @brief Addition operator
 */
pub abstract class Add {
	/*
	 * @brief Add values
	 *
	 * @param other Add Value to add to self
	 *
	 * @returns Add
	 */
	pub abstract func add(other: Add) -> Add
	/*
	 * @brief Prefix increment value
	 *
	 * @returns Add
	 */
	pub abstract func preIncrement() -> Add!
	/*
	 * @brief Postfix increment value
	 *
	 * @returns Add
	 */
	pub abstract func postIncrement() -> Add!
	/*
	 * @brief Prefix decrement value
	 *
	 * @returns Add
	 */
	pub abstract func preDecrement() -> Add!
	/*
	 * @brief Postfix decrement value
	 *
	 * @returns Add
	 */
	pub abstract func postDecrement() -> Add!
}

/*
 * @brief Subtraction operator
 */
pub abstract class Subtract {
	/*
	 * @brief Subtract values
	 *
	 * @param other Subtract Value to subtract from self
	 *
	 * @returns Subtract
	 */
	pub abstract func subtract(other: Subtract) -> Subtract
	/*
	 * @brief Negate value
	 *
	 * @returns Subtract
	 */
	pub abstract func negate() -> Subtract!
}

/*
 * @brief Multiplication operator
 */
pub abstract class Multiply {
	/*
	 * @brief Multiply values
	 *
	 * @param other Multiply Value to multiply by self
	 *
	 * @returns Multiply
	 */
	pub abstract func multiply(other: Multiply) -> Multiply
}

/*
 * @brief Division operator
 */
pub abstract class Divide {
	/*
	 * @brief Divide values
	 *
	 * @param other Divide Value to divide self by
	 *
	 * @returns Divide
	 */
	pub abstract func divide(other: Divide) -> Divide
}

/*
 * @brief Modulus operator
 */
pub abstract class Modulo {
	/*
	 * @brief Get remainder of division operation
	 *
	 * @param other Modulo Value to divide self by
	 *
	 * @returns Modulo
	 */
	pub abstract func modulo(other: Modulo) -> Modulo
}

/*
 * @brief Bitwise or operator
 */
pub abstract class BitwiseOr {
	/*
	 * @brief Bitwise or values
	 *
	 * @param other BitwiseOr Value to bitwise or with
	 *
	 * @returns BitwiseOr
	 */
	pub abstract func bitwiseOr(other: BitwiseOr) -> BitwiseOr
}

/*
 * @brief Bitwise and operator
 */
pub abstract class BitwiseAnd {
	/*
	 * @brief Bitwise and values
	 *
	 * @param other BitwiseAnd Value to bitwise and with
	 *
	 * @returns BitwiseAnd
	 */
	pub abstract func bitwiseAnd(other: BitwiseAnd) -> BitwiseAnd
}

/*
 * @brief Bitwise xor operator
 */
pub abstract class BitwiseXor {
	/*
	 * @brief Bitwise xor values
	 *
	 * @param other BitwiseXor Value to bitwise xor with
	 *
	 * @returns BitwiseXor
	 */
	pub abstract func bitwiseXor(other: BitwiseXor) -> BitwiseXor
	/*
	 * @brief Bitwise not value (Equivalent to xor'ing by all ones)
	 *
	 * @returns BitwiseXor
	 */
	pub abstract func bitwiseNot() -> BitwiseXor!
}

/*
 * @brief Bitwise left shift operator
 */
pub abstract class BitwiseLeftShift {
	/*
	 * @brief Bitwise left shift value
	 *
	 * @param other BitwiseLeftShift Value to bitwise left shift by
	 *
	 * @returns BitwiseLeftShift
	 */
	pub abstract func bitwiseLeftShift(other: BitwiseLeftShift) -> BitwiseLeftShift
}

/*
 * @brief Bitwise right shift operator
 */
pub abstract class BitwiseRightShift {
	/*
	 * @brief Bitwise right shift value
	 *
	 * @param other BitwiseRightShift Value to bitwise right shift by
	 *
	 * @returns BitwiseRightShift
	 */
	pub abstract func bitwiseRightShift(other: BitwiseRightShift) -> BitwiseRightShift
}

/*
 * @brief Equals operator
 */
pub abstract class Equals {
	/*
	 * @brief Compare equality of values
	 *
	 * @param other Equals Value to compare with
	 *
	 * @returns Boolean
	 */
	pub abstract func equals(other: Equals) -> Boolean
}

/*
 * @brief Less than operator
 */
pub abstract class LessThan {
	/*
	 * @brief Compare order of values
	 *
	 * @param other LessThan Value to compare with
	 *
	 * @returns Boolean
	 */
	pub abstract func lessThan(other: LessThan) -> Boolean
}

/*
 * @brief Greater than operator
 */
pub abstract class GreaterThan {
	/*
	 * @brief Compare order of values
	 *
	 * @param other Equals Value to compare with
	 *
	 * @returns Boolean
	 */
	pub abstract func greaterThan(other: GreaterThan) -> Boolean
}

/*
 * @brief Truthiness operator
 */
pub abstract class True {
	/*
	 * @brief Get truthiness of value
	 *
	 * @returns Boolean
	 */
	pub abstract func isTrue() -> Boolean
}

/*
 * @brief Index operator
 *
 * @gparam K The type of key used as an index
 * @gparam V The type of value stored by the container
 */
pub abstract class Index<K, V> {
	/*
	 * @brief Get value at index
	 *
	 * @desc This function should make use of\
	 * assertions for bounds checks.
	 *
	 * @param index K The index of the value
	 *
	 * @returns V
	 */
	pub abstract func get(index: K) -> V

	/*
	 * @brief Set value at index
	 *
	 * @desc This function should make use of\
	 * assertions for bounds checks.
	 *
	 * @param index K The index of the value
	 * @param value V The value to set
	 *
	 * @returns V The value assigned
	 */
	pub abstract func set(index: K, value: V) -> V
}

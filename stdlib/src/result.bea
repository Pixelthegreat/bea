module result

/*
 * @brief Common error
 */
pub class Error {
	/*
	 * @brief Error message
	 */
	pub message: String

	/*
	 * @brief Construct error
	 *
	 * @param message std::string::String The error message
	 */
	pub func init(message: String)!
}

/*
 * @brief Common result
 *
 * @gparam T The type of value carried by the result
 */
pub struct Result<T> {
	/*
	 * @brief The value carried by the result
	 */
	pub value: T
	/*
	 * @brief The optional error carried by the result
	 */
	pub error: Error
	/*
	 * @brief okay Indicates if the result is a success
	 */
	pub okay: Boolean = true

	/*
	 * @brief Construct result with default value
	 */
	pub func init()!
	/*
	 * @brief Construct result with value
	 *
	 * @param T value The value
	 */
	pub func init(value: T)!
	/*
	 * @brief Construct fail result with error
	 *
	 * @param Error error The error
	 */
	pub func init(error: Error) {
		this.okay = false
	}
}

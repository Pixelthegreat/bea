module result

/*
 * @brief Common error
 *
 * @field message The error message.
 */
pub class Error {
	pub message: String

	/*
	 * @brief Initialize error
	 */
	pub func init(message: String)!
}

/*
 * @brief Common result
 *
 * @gparam T The type of value carried by the result.
 *
 * @field value The value carried by the result.
 * @field error The optional error carried by the result.
 * @field okay `true` if the result is a success, `false` otherwise.
 */
pub struct Result<T> {
	pub value: T
	pub error: Error
	pub okay: Boolean = true

	/*
	 * @name init
	 * @brief Initialize result
	 */
	pub func init()!
	pub func init(value: T)!
	pub func init(error: Error) {
		this.okay = false
	}
}

/*
 * @brief Create a success result
 *
 * @gparam T The type of result.
 *
 * @param value The value of the result.
 *
 * @returns The result.
 */
pub func Okay<T>(value: T) -> Result<T> => new Result<T>(value)

/*
 * @brief Create a failure result
 *
 * @gparam T The type of result.
 *
 * @param error The error of the result.
 *
 * @returns The result.
 */
pub func Fail<T>(error: Error) -> Result<T> => new Result<T>(error)
